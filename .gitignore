# ==========================================
# R SPECIFIC FILES
# ==========================================
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj
*.rda
*.rds
.renv/

# ==========================================
# ENVIRONMENT MANAGEMENT
# ==========================================
renv/
venv/
env/

# ==========================================
# DATA FILES (Open Science: Se ignoran bases pesadas)
# ==========================================
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Datos binarios y pesados de Stata, R, SPSS y Excel
*.dta
*.sav
*.csv
*.xlsx

# ==========================================
# OUTPUT FILES (Permitir sincronización con Overleaf)
# ==========================================
# Se ignoran formatos temporales o pesados de salida
output/*.html
output/*.xlsx
output/*.csv

# PERMITIR explícitamente código LaTeX (.tex) y gráficos (.pdf / .png)
!output/
!output/*.gitkeep
!output/**/*.tex
!output/**/*.pdf
!output/**/*.png

# ==========================================
# STATA & OS SPECIFIC
# ==========================================
*.gph
*.stsem
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/