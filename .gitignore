# ==========================================
# DATA FILES (Keep raw data if non-confidential)
# ==========================================
# Descomenta si los datos son confidenciales:
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.json
!data/raw/.gitkeep

# Keep processed data (regenerable from raw)
data/processed/*.csv
data/processed/*.xlsx
!data/processed/.gitkeep

# ==========================================
# OUTPUT FILES (REGENERABLE)
# ==========================================
output/*.png
output/*.pdf
output/*.html
output/*.jpg
output/*.jpeg
output/*.svg
output/*.xlsx
output/*.csv
!output/.gitkeep

# ==========================================
# VSCODE
# ==========================================
.vscode/
!.vscode/settings.json
!.vscode/launch.json

